+      - '.env.sample'
+      - '.github/firstrun/plan.json'
+      - '**/*.py'
+      - 'src/**'
+permissions:
+  contents: read
+  pull-requests: write
+jobs:
+  guard:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4

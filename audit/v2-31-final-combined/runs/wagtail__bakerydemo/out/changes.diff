+      - 'docker-compose*.yml'
+      - 'compose*.yml'
+      - '.env.example'
+      - '.env.sample'
+      - '.github/firstrun/plan.json'
+      - '**/*.py'
+      - 'src/**'
+permissions:
+  contents: read
+  pull-requests: write
+jobs:
+  guard:
+    runs-on: ubuntu-latest
+    steps:

# App's running environment
NODE_ENV=

# App's running port
PORT=4000

# Server url
SERVER_URL=http://localhost:4000

# Cors origin url
CORS_ORIGIN=*

# Run node -e "console.log(require('crypto').randomBytes(256).toString('base64'));" in your console to generate a secret
ACCESS_TOKEN_SECRET=change.me.local.dev.only.not.a.secret

REFRESH_TOKEN_SECRET=change.me.local.dev.only.not.a.secret

ACCESS_TOKEN_EXPIRE=20m

REFRESH_TOKEN_EXPIRE=1d

# name of the refresh token cookie
REFRESH_TOKEN_COOKIE_NAME=jid

MYSQL_DATABASE=app
MYSQL_ROOT_PASSWORD=change.me.local.dev.only.not.a.secret

# Example: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:change.me.local.dev.only.not.a.secret@localhost:3306/app

# Configuration for the emial service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev
SMTP_PASSWORD=change.me.local.dev.only.not.a.secret
EMAIL_FROM=dev@example.com